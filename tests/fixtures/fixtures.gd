class_name Fixtures
## Loads test fixtures from tests/fixtures/ (generated by tools/make_fixtures.gd).

const DIR := "res://tests/fixtures/"


static func map() -> MapData:
	return load(DIR + "map_8x8.tres")


static func unit_data(id: String) -> UnitData:
	return load(DIR + "unit_%s.tres" % id)


static func item(id: String) -> ItemData:
	return load(DIR + "item_%s.tres" % id)


static func class_data(id: String) -> ClassData:
	return load(DIR + "class_%s.tres" % id)


static func all_paths() -> PackedStringArray:
	var out := PackedStringArray()
	for f in DirAccess.get_files_at(DIR):
		if f.ends_with(".tres"):
			out.append(DIR + f)
	return out
