class_name Fixtures
## Loads test fixtures from tests/fixtures/ (generated by tools/make_fixtures.gd).

const DIR := "res://tests/fixtures/"


static func map() -> MapData:
	_register()
	return load(DIR + "map_8x8.tres")


static func unit_data(id: String) -> UnitData:
	_register()
	return load(DIR + "unit_%s.tres" % id)


static func item(id: String) -> ItemData:
	return load(DIR + "item_%s.tres" % id)


static func class_data(id: String) -> ClassData:
	return load(DIR + "class_%s.tres" % id)


## hero (leader), knight, archer, scout.
static func party() -> Array[Unit]:
	var out: Array[Unit] = []
	for id in ["hero", "knight", "archer", "scout"]:
		out.append(Unit.from_data(unit_data(id)))
	out[0].is_leader = true
	return out


static func battle(p_seed := 1) -> BattleState:
	var b := BattleState.new(map(), party(), p_seed)
	b.start()
	return b


## An all-plain map with optional per-tile overrides: {Vector2i: [terrain_id, height]}.
## Terrain ids: 0 plain, 1 forest, 2 hill, 3 wall.
static func open_map(size: Vector2i, overrides := {}) -> MapData:
	var m := MapData.new()
	m.id = &"open"
	m.size = size
	m.terrain_types = [
		load("res://data/terrain/plain.tres"), load("res://data/terrain/forest.tres"),
		load("res://data/terrain/hill.tres"), load("res://data/terrain/wall.tres"),
	]
	m.heights.resize(size.x * size.y)
	m.terrain_ids.resize(size.x * size.y)
	for t: Vector2i in overrides:
		m.terrain_ids[m.index(t)] = overrides[t][0]
		m.heights[m.index(t)] = overrides[t][1]
	m.player_spawns = [Vector2i.ZERO]
	return m


## A player unit (hero data) placed on a fresh grid.
static func unit_on(g: Grid, at: Vector2i, faction := Enums.Faction.PLAYER, id := "hero") -> Unit:
	var u := Unit.from_data(unit_data(id), faction)
	g.place(u, at)
	return u


## A small battle on an open map. Players (hero, knight, archer, scout order) at
## `players`, goblins at `enemies`. Hero is the leader.
static func duel(players: Array, enemies: Array, p_seed := 1, size := Vector2i(8, 8), overrides := {}) -> BattleState:
	var m := open_map(size, overrides)
	m.player_spawns.clear()
	for p: Vector2i in players:
		m.player_spawns.append(p)
	for e: Vector2i in enemies:
		var sp := EnemySpawn.new()
		sp.unit = unit_data("goblin")
		sp.at = e
		m.enemies.append(sp)
	var b := BattleState.new(m, party(), p_seed)
	b.start()
	return b


## Lets everyone else Wait until `u` is the acting unit.
static func act_as(b: BattleState, u: Unit) -> void:
	for i in 100:
		if b.current_actor() == u:
			return
		b.apply(WaitCommand.by(b.current_actor().id))
	assert(false, "unit %d never got a turn" % u.id)


static func chapter(n: int) -> ChapterData:
	_register()
	return load(DIR + "chapter_%02d.tres" % n)


## Plays AI vs AI with increasing seeds until the battle is won. Returns the won battle.
static func win_battle(c: Campaign, first_seed := 0) -> BattleState:
	for s in range(first_seed, first_seed + 200):
		var b := c.start_battle(s)
		b.start()
		if AutoPlay.play_to_end(b) == BattleState.Outcome.WON:
			return b
	assert(false, "no winning seed found")
	return null


static func all_paths() -> PackedStringArray:
	var out := PackedStringArray()
	for f in DirAccess.get_files_at(DIR):
		if f.ends_with(".tres"):
			out.append(DIR + f)
	return out


static func _register() -> void:
	Content.register_dir(DIR)
