; Engine configuration file.
; Godot version pinned in .godot-version

config_version=5

[application]

config/name="Banner"
config/version="0.1.0"
run/main_scene="res://view/screens/title.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Game="*res://autoload/game.gd"
SaveService="*res://autoload/save_service.gd"
Audio="*res://autoload/audio.gd"
Transition="*res://autoload/transition.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/banner_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
